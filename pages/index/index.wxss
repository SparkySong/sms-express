.container {
  padding: 0;
  background-color: var(--color-bg-1);
  padding-bottom: 40rpx;
}

/* 今日头条 */
.headline-section {
  background-color: var(--color-bg-card);
  padding-bottom: 30rpx;
  border-bottom: 20rpx solid var(--color-bg-2);
}

.section-title {
  font-size: var(--font-title);
  font-weight: bold;
  padding: 30rpx;
}

/* 轮播图样式 */
.headline-swiper {
  height: 400rpx;
}

.headline-card {
  position: relative;
  margin: 0 30rpx;
  height: 400rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.headline-image {
  width: 100%;
  height: 100%;
}

.headline-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  color: #fff;
  z-index: 1;
}

.headline-title {
  font-size: var(--font-lg);
  font-weight: bold;
  margin-bottom: 10rpx;
}

.headline-desc {
  font-size: var(--font-body);
  opacity: 0.9;
}

/* 自定义轮播点样式 */
.wx-swiper-dots {
  position: relative;
  bottom: 20rpx !important;
}

.wx-swiper-dot {
  width: 8rpx;
  height: 8rpx;
  margin-left: 6rpx;
  margin-right: 6rpx;
}

.wx-swiper-dot-active {
  width: 16rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-primary) !important;
}

/* 最新资讯 */
.news-section {
  background-color: var(--color-bg-card);
}

.news-list {
  background-color: var(--color-bg-card);
}

.news-item {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.news-content {
  flex: 1;
  margin-bottom: 20rpx;
}

.news-title {
  font-size: var(--font-lg);
  font-weight: 500;
  margin-bottom: 16rpx;
  line-height: 1.4;
  padding-right: 260rpx;
}

.news-info {
  font-size: var(--font-caption);
  color: var(--color-text-3);
  margin-bottom: 16rpx;
}

.news-source,
.news-time,
.news-reads {
  display: inline-block;
}

.news-dot {
  margin: 0 10rpx;
  display: inline-block;
}

.news-image {
  position: absolute !important;
  right: 30rpx !important;
  top: 30rpx !important;
}

.news-actions {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-top: 20rpx;
}

.action-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
}

.action-icon {
  margin-right: 4rpx;
  color: var(--color-text-2);
  display: flex;
  align-items: center;
}

.action-count, .action-text {
  font-size: var(--font-caption);
  color: var(--color-text-2);
}

/* 自定义Vant组件样式 */
.van-tabs__line {
  background-color: var(--color-primary) !important;
}

.van-tab--active {
  color: var(--color-primary) !important;
  font-weight: bold;
}

/* 小屏兜底 */
@media screen and (min-width: 375px) {
  .news-item {
    min-height: 160rpx;
  }
}

/* 空数据状态 */
.empty-data {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  width: 100%;
  color: var(--color-text-3);
}

.empty-data text {
  margin-top: 20rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: var(--color-text-3);
  font-size: var(--font-body);
}
