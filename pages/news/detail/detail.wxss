/* pages/news/detail/detail.wxss */
page {
  background-color: var(--color-bg-1);
  line-height: 1.6;
  padding-bottom: 120rpx;
}

.container {
  padding: 30rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  box-shadow: 0 4rpx 24rpx rgba(100, 101, 102, 0.08);
}

/* 文章头部 */
.article-header {
  margin-bottom: 30rpx;
}

.article-title {
  font-size: var(--font-title-xl);
  font-weight: 600;
  line-height: 1.4;
  color: var(--color-text-1);
  margin-bottom: 24rpx;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-caption);
  color: var(--color-text-3);
  margin-bottom: 10rpx;
}

.source-info {
  display: flex;
  align-items: center;
}

.source-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.source-name {
  font-weight: 500;
  color: var(--color-text-2);
}

.right-info {
  display: flex;
  align-items: center;
}

.publish-time {
  margin-right: 16rpx;
  color: var(--color-text-3);
}

.category-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background-color: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-caption);
  border-radius: var(--radius-sm);
}

/* 管理员操作按钮 */
.admin-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-border);
}

/* 文章内容 */
.article-content {
  margin-bottom: 40rpx;
}

.cover-image-container {
  margin-bottom: 30rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.cover-image {
  width: 100%;
  border-radius: var(--radius-md);
}

.article-text {
  font-size: var(--font-md);
  line-height: 1.8;
  color: var(--color-text-1);
  margin-bottom: 30rpx;
}

/* 查看原文链接样式 */
.source-link-cell {
  margin: 20rpx 0;
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-2) !important;
}

/* 文章标签 */
.article-tags {
  margin: 10rpx 0 30rpx;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  margin: 0 16rpx 16rpx 0 !important;
}

/* 相关推荐 */
.related-news {
  margin-top: 20rpx;
}

.related-list {
  margin-top: 10rpx;
}

.related-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  position: relative;
}

.item-hover {
  background-color: var(--color-bg-2);
}

.related-content {
  flex: 1;
  margin-right: 20rpx;
  overflow: hidden;
}

.related-title {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--color-text-1);
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.related-info {
  font-size: var(--font-caption);
  color: var(--color-text-3);
  display: flex;
  align-items: center;
}

.related-source {
  margin-right: 8rpx;
}

.dot {
  margin: 0 8rpx;
}

.related-image {
  width: 160rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

/* 底部操作栏（含全面屏安全区） */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  min-height: 100rpx;
  background-color: var(--color-bg-card);
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  padding: 10rpx 0;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  z-index: 99;
}

.action-button {
  height: 70rpx !important;
  line-height: 68rpx !important;
  padding: 0 30rpx !important;
  font-size: 26rpx !important;
  border-radius: 35rpx !important;
}

/* 评论面板样式 */
.comments-popup {
  display: flex;
  flex-direction: column;
  height: 100%;
  position: relative;
}

.comments-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.comments-title {
  font-size: var(--font-lg);
  font-weight: 500;
}

.comments-content {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx 40rpx;
}

.empty-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--color-text-3);
}

.empty-text {
  margin-top: 30rpx;
  font-size: var(--font-body);
}

/* 评论列表样式 */
.comment-list {
  padding-bottom: 40rpx;
}

.comment-item {
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.comment-user {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-avatar-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--color-text-1);
}

.comment-time {
  font-size: var(--font-caption);
  color: var(--color-text-3);
  margin-top: 4rpx;
}

.comment-content {
  font-size: var(--font-body);
  line-height: 1.5;
  color: var(--color-text-1);
  margin-bottom: 16rpx;
  word-break: break-all;
}

.comment-actions {
  display: flex;
  justify-content: flex-end;
}

.comment-like, .comment-reply {
  display: flex;
  align-items: center;
  font-size: var(--font-caption);
  color: var(--color-text-3);
  margin-left: 30rpx;
}

.comment-like.liked {
  color: var(--color-like);
}

.comment-like text, .comment-reply text {
  margin-left: 8rpx;
}

/* 回复列表样式 */
.reply-list {
  background-color: var(--color-bg-1);
  border-radius: var(--radius-sm);
  padding: 16rpx 24rpx;
  margin-top: 20rpx;
}

.reply-item {
  margin-bottom: 20rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-user {
  display: flex;
  align-items: flex-start;
}

.reply-info {
  flex: 1;
}

.reply-name-content {
  font-size: var(--font-sm);
  color: var(--color-text-1);
  line-height: 1.5;
}

.reply-to {
  color: var(--color-text-3);
  margin: 0 8rpx;
}

.reply-content {
  display: inline;
  word-break: break-all;
}

.reply-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.reply-actions {
  display: flex;
}

/* 评论输入框样式 */
.comment-input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background-color: var(--color-bg-2);
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: var(--font-body);
}

.comment-submit {
  margin-left: 20rpx;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: var(--font-body);
  color: var(--color-text-3);
  background-color: var(--color-bg-2);
}

.comment-submit.active {
  color: #fff;
  background-color: var(--color-primary);
}

/* 适配暗黑模式 */
@media (prefers-color-scheme: dark) {
  page {
    background-color: #1a1a1a;
    color: #f5f5f5;
  }

  .container {
    background-color: #222;
    box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.2);
  }

  .article-title {
    color: #f0f0f0;
  }

  .article-text {
    color: #e0e0e0;
  }

  .related-title {
    color: #e0e0e0;
  }

  .source-link-cell {
    background-color: #2a2a2a !important;
  }

  .action-bar {
    background-color: #222;
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.3);
  }

  .item-hover {
    background-color: #2a2a2a;
  }

  .related-item {
    border-bottom: 1rpx solid #333;
  }

  .comments-header {
    border-bottom: 1rpx solid #333;
  }

  .empty-comments {
    color: #888;
  }

  .comment-item {
    border-bottom: 1rpx solid #333;
  }

  .user-name {
    color: #f0f0f0;
  }

  .comment-content {
    color: #e0e0e0;
  }

  .reply-list {
    background-color: #2a2a2a;
  }

  .reply-name-content {
    color: #e0e0e0;
  }

  .comment-input-area {
    border-top: 1rpx solid #333;
    background-color: #222;
  }

  .comment-input {
    background-color: #333;
    color: #e0e0e0;
  }

  .comment-submit {
    background-color: #333;
    color: #999;
  }
}

/* 文章内容样式 */
rich-text {
  line-height: 1.8;
}

rich-text .h1 {
  font-size: var(--font-title-xl);
  font-weight: bold;
  margin: 32rpx 0;
}

rich-text .h2 {
  font-size: var(--font-title);
  font-weight: bold;
  margin: 28rpx 0;
}

rich-text .p {
  margin-bottom: 24rpx;
}

rich-text .strong {
  font-weight: bold;
}

rich-text .img {
  max-width: 100%;
  margin: 20rpx 0;
  border-radius: var(--radius-sm);
}

/* 隐藏微信分享按钮但保留功能 */
.share-button-hidden {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  margin: -1rpx;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

/* 优化移动端显示 */
@media (max-width: 768px) {
  .action-button {
    padding: 0 20rpx !important;
    font-size: 24rpx !important;
  }
}

/* 自定义分享面板 */
.custom-share-panel {
  padding: 30rpx;
}

.share-title {
  font-size: var(--font-lg);
  font-weight: 500;
  text-align: center;
  padding: 20rpx 0 40rpx;
  color: var(--color-text-1);
}

.share-options {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
}

.share-option {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.option-name {
  margin-top: 16rpx;
  font-size: var(--font-sm);
  color: var(--color-text-2);
}

.share-cancel {
  margin-top: 20rpx;
  padding: 20rpx 0;
  text-align: center;
  color: var(--color-text-2);
  font-size: var(--font-body);
  border-top: 1rpx solid var(--color-border);
}

/* 适配暗黑模式（分享面板） */
@media (prefers-color-scheme: dark) {
  .share-title {
    color: #f2f3f5;
  }

  .option-name {
    color: #c8c9cc;
  }

  .share-cancel {
    color: #c8c9cc;
    border-top: 1rpx solid #3a3a3c;
  }
}
