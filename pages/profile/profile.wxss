/* pages/profile/profile.wxss */
.container {
  display: flex;
  flex-direction: column;
  padding-bottom: 30rpx;
}

/* 顶部用户信息区域 */
.profile-header {
  width: 100%;
  margin-bottom: 140rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: var(--gradient-brand);
  z-index: 1;
}

/* 用户卡片 */
.user-card {
  position: absolute;
  display: flex;
  align-items: center;
  top: 80rpx;
  left: 30rpx;
  right: 30rpx;
  padding: 30rpx;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card-strong);
  z-index: 2;
  transition: all 0.3s ease;
}

.avatar-wrapper {
  position: relative;
  margin-right: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid var(--color-bg-card);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.login-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background-color: var(--color-primary);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: var(--font-title);
  font-weight: bold;
  color: var(--color-text-1);
  margin-bottom: 8rpx;
}

.login-tip {
  font-size: var(--font-caption);
  color: var(--color-text-2);
}

.edit-profile {
  margin-top: 16rpx;
  font-size: var(--font-caption);
  color: var(--color-text-2);
  display: flex;
  align-items: center;
  width: fit-content;
  padding: 6rpx 20rpx;
  background-color: var(--color-bg-2);
  border-radius: 30rpx;
  transition: all 0.3s ease;
}

.edit-profile:active {
  background-color: var(--color-bg-3);
}

/* 用户数据统计 */
.user-stats {
  display: flex;
  justify-content: space-between;
  margin: 180rpx 30rpx 30rpx;
  padding: 30rpx 0;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  transition: all 0.3s ease;
}

.stat-item:active {
  background-color: var(--color-bg-2);
}

.stat-count {
  font-size: var(--font-title);
  font-weight: bold;
  color: var(--color-text-1);
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: var(--font-caption);
  color: var(--color-text-3);
}

.divider {
  width: 1rpx;
  background-color: var(--color-border);
  height: 50rpx;
  margin-top: 20rpx;
}

/* 功能菜单 */
.section-title {
  font-size: var(--font-md);
  font-weight: bold;
  color: var(--color-text-1);
  margin: 10rpx 30rpx 20rpx;
}

.menu-list {
  margin: 0 30rpx;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
  transition: all 0.3s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  background-color: var(--color-bg-2);
}

.menu-icon-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: var(--font-body);
  color: var(--color-text-1);
}

.menu-arrow {
  color: var(--color-text-4);
  font-size: var(--font-body);
}

/* 退出登录按钮 */
.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 30rpx 30rpx;
  padding: 24rpx;
  background-color: var(--color-bg-card);
  color: var(--color-danger);
  font-size: var(--font-md);
  text-align: center;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  transition: all 0.3s ease;
}

.logout-btn:active {
  background-color: var(--color-danger-light);
}

/* 版本信息 */
.version-info {
  text-align: center;
  font-size: var(--font-caption);
  color: var(--color-text-3);
  margin-top: 10rpx;
}
